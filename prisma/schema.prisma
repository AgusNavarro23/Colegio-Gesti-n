generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("CLIENT")
  resetToken String?
  resetTokenExpiry DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  usersCreated User[]  @relation("UserCreatedBy")

  escribanosCreados      Escribano[]           @relation("EscribanoCreatedBy")
  escribanosActualizados Escribano[]           @relation("EscribanoUpdatedBy")
  registrosCreados       Registro[]            @relation("RegistroCreatedBy")
  registrosActualizados  Registro[]            @relation("RegistroUpdatedBy")
  arancelesCreados       Arancel[]             @relation("ArancelCreatedBy")
  arancelesActualizados  Arancel[]             @relation("ArancelUpdatedBy")
  declaracionesCreadas       DeclaracionJurada[] @relation("DeclaracionJuradaCreatedBy")
  declaracionesActualizadas  DeclaracionJurada[] @relation("DeclaracionJuradaUpdatedBy")
  verificacionesCreadas      DeclaracionVerificar[] @relation("VerificacionCreatedBy")
  verificacionesActualizadas DeclaracionVerificar[] @relation("VerificacionUpdatedBy")
  configuracionesCreadas      ConfiguracionAporte[] @relation("ConfiguracionAporteCreatedBy")
  configuracionesActualizadas ConfiguracionAporte[] @relation("ConfiguracionAporteUpdatedBy")
}

model Escribano {
  id        String   @id @default(cuid())
  nombre    String
  matricula String   @unique
  dni       String   @unique
  cuit      String?
  fechaHabilitacion DateTime?
  estado    String   @default("Activo")
  condicion String   @default("Titular")
  categoria String   @default("D")
  registroId String?
  registro Registro? @relation(fields: [registroId], references: [numero])
  declaraciones DeclaracionJurada[]
  verificaciones DeclaracionVerificar[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?  @relation("EscribanoCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?  @relation("EscribanoUpdatedBy", fields: [updatedById], references: [id])
}

model Registro {
  id        String   @id @default(cuid())
  numero    String   @unique
  direccion String
  localidad String
  escribanos  Escribano[]
  estado    String   @default("Activo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  declaraciones DeclaracionJurada[]
  verificaciones DeclaracionVerificar[]

  createdById String?
  createdBy   User?  @relation("RegistroCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?  @relation("RegistroUpdatedBy", fields: [updatedById], references: [id])
}

model Arancel {
  id String @id @default(cuid())
  codigoRenta String
  descripcion String
  minimo Float
  maximo Float
  porcentaje1 Float
  porcentaje2 Float
  porcentaje3 Float
  adicional Float
  observaciones String?
  detalles      DetalleDeclaracion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?  @relation("ArancelCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?  @relation("ArancelUpdatedBy", fields: [updatedById], references: [id])
}

model DeclaracionJurada {
  id         String   @id @default(cuid())
  numerodj   String
  codigodj   String
  fecha_acto DateTime
  fecha_vto  DateTime
  fecha_pago DateTime?
  tipo_pago  String @default("Banco")
  anio       Int @default(2026)
  aranceltip Float
  rubroA     Float
  rubroB     Float
  rubroC     Float
  rubroD     Float
  total      Float

  registroId  String
  registro    Registro @relation(fields: [registroId], references: [numero])

  escribanoId String
  escribano   Escribano @relation(fields: [escribanoId], references: [id])

  detalles   DetalleDeclaracion[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([numerodj, registroId, anio])

  createdById String?
  createdBy   User?  @relation("DeclaracionJuradaCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?  @relation("DeclaracionJuradaUpdatedBy", fields: [updatedById], references: [id])
}

model DetalleDeclaracion {
  id                  String   @id @default(cuid())
  monto               Float
  arancelCalculado    Float

  declaracionJuradaId String
  declaracionJurada   DeclaracionJurada @relation(fields: [declaracionJuradaId], references: [id], onDelete: Cascade)

  arancelId           String
  arancel             Arancel           @relation(fields: [arancelId], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DeclaracionVerificar {
  id                String   @id @default(cuid())
  archivoOrigen     String
  nro_registro      Int
  cuit_escribano    String
  nombre_oficial    String
  fecha_acto        String
  fecha_vto         String?
  tipo_pago         String   @default("Banco")
  anio              Int      @default(2026)
  nro_escritura     Int      @default(0)
  codigo_dj         Int      @default(0)
  arancel_tip       Float
  arancel_calculado Float
  total_general     Float
  rubroA            Float    @default(0)
  rubroB            Float    @default(0)
  rubroC            Float    @default(0)
  rubroD            Float    @default(0)
  prioridad         String   @default("BAJA")
  nivelRiesgo       String   @default("VERDE")
  motivos_riesgo    String?
  estado            String   @default("PENDIENTE_REVISION")
  actos_resumen     String?
  detalles_arancel  String?
  pdfPath           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  registroId  String?
  escribanoId String?
  registro    Registro?  @relation(fields: [registroId], references: [numero])
  escribano   Escribano? @relation(fields: [escribanoId], references: [id])

  createdById String?
  createdBy   User?  @relation("VerificacionCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?  @relation("VerificacionUpdatedBy", fields: [updatedById], references: [id])
}

model ConfiguracionAporte {
  id           String   @id @default(cuid())
  fechaInicio  DateTime
  fechaFin     DateTime
  montoA       Float
  montoB       Float
  montoC       Float
  montoD       Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById String?
  createdBy   User?  @relation("ConfiguracionAporteCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?  @relation("ConfiguracionAporteUpdatedBy", fields: [updatedById], references: [id])
}
